{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "removeComments": true,
    "rootDir": ".",
    "outDir": "dist-build"
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "packages/protocol/src/**/*.ts"]
}
